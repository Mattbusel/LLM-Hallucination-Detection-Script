"""Type stubs for the compiled half of llm_token_visualizer."""

from typing import ClassVar

DEFAULT_THRESHOLD: float
__version__: str

class LogprobsError(ValueError):
    """The response could not be read as token logprobs."""

class NoLogprobsError(LogprobsError):
    """The response has no token logprobs (request them with logprobs=True)."""

class Span:
    """One run of low-confidence words. Offsets are characters into Score.text.

    Spans compare equal when every field is equal; they are not hashable.
    """

    __hash__: ClassVar[None]  # type: ignore[assignment]
    def __eq__(self, other: object) -> bool: ...

    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def token_start(self) -> int: ...
    @property
    def token_end(self) -> int: ...
    @property
    def text(self) -> str: ...
    @property
    def min_logprob(self) -> float: ...
    @property
    def mean_logprob(self) -> float: ...
    @property
    def min_prob(self) -> float: ...
    @property
    def weakest_token(self) -> str: ...
    @property
    def alternatives(self) -> list[tuple[str, float]]: ...
    @property
    def entropy_bits(self) -> float | None: ...
    def describe(self) -> str: ...
    def to_dict(self) -> dict[str, object]: ...

class Score:
    """The result of score()."""

    @property
    def text(self) -> str: ...
    @property
    def threshold(self) -> float: ...
    @property
    def token_count(self) -> int: ...
    @property
    def mean_prob(self) -> float: ...
    @property
    def perplexity(self) -> float: ...
    @property
    def flagged(self) -> bool: ...
    @property
    def model(self) -> str | None: ...
    def spans(self) -> list[Span]: ...
    def to_html(self, title: str | None = None) -> str: ...
    def to_markdown(self, title: str | None = None) -> str: ...
    def summary(self) -> str: ...
    def to_json(self) -> str: ...

def score_json(
    json: str, threshold: float, model: str | None = None, *, choice: int = 0
) -> Score: ...
